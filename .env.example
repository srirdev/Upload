APP_ENV=development
SECRET_KEY=change-me-generate-a-long-random-string
CORS_ORIGINS=["http://localhost:5173"]

# Local PostgreSQL (existing install). Real values go only in the git-ignored .env.
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://UPLOAD_USER:UPLOAD_PASSWORD@localhost:5432/upload_db

# Initial administrator, created only when you run: cd backend && python -m app.modules.auth.cli
ADMIN_MOBILE=
ADMIN_NAME=
ADMIN_EMAIL=

REDIS_URL=redis://localhost:6379/0

# Background jobs (backend/app/workers). LibreOffice converts DOCX/PPTX to PDF; empty = find `soffice` on PATH.
SOFFICE_PATH=
DRAFT_RETENTION_DAYS=30
COLLECTION_REMINDER_HOURS=2

# Only for `docker compose --profile postgres` (machines without a local PostgreSQL)
POSTGRES_PASSWORD=

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=upload-private
S3_REGION=us-east-1

# Razorpay (leave empty until you have test keys; payments stay disabled, never mocked as success)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Demo accounts (DEVELOPMENT ONLY): python -m app.modules.auth.demo. Empty DEMO_PASSWORD = disabled.
DEMO_PASSWORD=
DEMO_STUDENT_MOBILE=9000000101
DEMO_STUDENT_EMAIL=student@demo.upload
DEMO_SHOP_MOBILE=9000000102
DEMO_SHOP_EMAIL=shop@demo.upload
DEMO_RIDER_MOBILE=9000000103
DEMO_RIDER_EMAIL=rider@demo.upload
DEMO_ADMIN_MOBILE=9000000104
DEMO_ADMIN_EMAIL=admin@demo.upload
